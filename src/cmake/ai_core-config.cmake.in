# ==================================================================================
# Config file for the ai_core package.
#
# It defines the following:
# - Imported targets for every component produced by this build.
# - The custom macro 'check_required_components' to ensure self-sufficiency.
# ==================================================================================

# --- Expanded by configure_package_config_file() ---
# Any changes to this file will be overwritten by the next CMake run.
# The input file was ai_core-config.cmake.in
# ---------------------------------------------------
@PACKAGE_INIT@

# --- Self-defined macro to avoid external dependencies ---
# This macro is a minimal, self-contained implementation inspired by
# CMake's standard macro and practices seen in other robust libraries
# like yaml-cpp. It ensures this config file works even if CMake's
# standard modules aren't in the search path during find_package().
macro(check_required_components _NAME)
  foreach(comp ${${_NAME}_FIND_COMPONENTS})
    if(NOT ${_NAME}_${comp}_FOUND)
      if(${_NAME}_FIND_REQUIRED_${comp})
        # If a required component is not found, the whole package is not found.
        set(${_NAME}_FOUND FALSE)
      endif()
    endif()
  endforeach()
endmacro()

# --- Include the targets file ---
# This file contains the definition for the IMPORTED target 'ai_core::ai_core'.
# It is generated by the install(EXPORT) command.
if(NOT TARGET ai_core::ai_core)
  include("${CMAKE_CURRENT_LIST_DIR}/ai_core-targets.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AICorePlugin.cmake")

set(ai_core_PLUGIN_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/ai_core/plugins")

# --- Components produced by this build ---
set(ai_core_core_FOUND TRUE)
set(ai_core_config_FOUND @AI_CORE_BUILD_CONFIG@)
set(ai_core_plugin_preproc_opencv_FOUND
    @AI_CORE_BUILD_PLUGIN_PREPROC_OPENCV@)
set(ai_core_plugin_postproc_opencv_FOUND
    @AI_CORE_BUILD_PLUGIN_POSTPROC_OPENCV@)
set(ai_core_plugin_onnxruntime_FOUND @AI_CORE_BUILD_PLUGIN_ONNXRUNTIME@)
set(ai_core_plugin_ncnn_FOUND @AI_CORE_BUILD_PLUGIN_NCNN@)
set(ai_core_plugin_tensorrt_FOUND @AI_CORE_BUILD_PLUGIN_TENSORRT@)

# --- Final check for requested components ---
# This uses the self-defined macro from above.
check_required_components(ai_core)
